# Copy this file to .env and fill in real values. .env is gitignored — never
# commit it. See docs/CONTEXT.md for the architecture these variables plug into.

# --- database --------------------------------------------------------------------
# Credentials docker-compose.yml uses to initialize the `db` container. Keep these
# three in sync with DATABASE_URL below if you change any of them.
POSTGRES_USER=aagp
POSTGRES_PASSWORD=aagp_dev_password
POSTGRES_DB=aagp

# SQLAlchemy connection string the backend reads to connect to Postgres. Matches
# the POSTGRES_* values above and the `db` service in docker-compose.yml.
DATABASE_URL=postgresql://aagp:aagp_dev_password@localhost:5432/aagp

# --- governance --------------------------------------------------------------------
# stub: canned opinions, zero LLM calls, safe default for everyone but the
# governance lane. cached: real Gemini responses replayed from recorded fixtures
# (the demo default). live: real Gemini API calls behind a flag, with a timeout
# and automatic fallback to cached. See docs/lanes/vc.md.
GOVERNANCE_MODE=stub

# Which LLM provider the governance agents use. One of: gemini, claude, openai.
# Gemini is the default and the only one with a free tier — the other two are optional
# extras (pip install 'governance[claude]') and nothing requires them. See ADR-0012.
GOVERNANCE_PROVIDER=gemini

# Optional per-agent override, one of the same three values. Four agents on one base
# model share that model's biases, so their errors correlate; putting one agent on a
# different provider is what makes their disagreement mean something.
#   GOVERNANCE_PROVIDER_RISK=claude
#   GOVERNANCE_PROVIDER_PERFORMANCE=gemini
#   GOVERNANCE_PROVIDER_COMPLIANCE=gemini
#   GOVERNANCE_PROVIDER_AUDIT=openai

# Google AI Studio API key for Gemini. Only read in `live` mode — leave blank for
# stub/cached, and the project must run end-to-end with it blank. Never commit a
# real key; it belongs in your local .env only.
GEMINI_API_KEY=

# Keys for the optional providers. Leave blank unless you are actually using them;
# both are paid APIs, so neither is needed for the demo or for CI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model overrides, if you want something other than each provider's default
# (gemini-3.6-flash, claude-opus-5, gpt-4o).
#   GEMINI_MODEL=
#   CLAUDE_MODEL=
#   OPENAI_MODEL=

# --- assistant (read-only chat panel) ------------------------------------------------
# live: calls the provider, falling back to a recorded reply on any failure. cached:
# replays a recorded reply only, zero network calls — the safe choice on a metered key
# mid-presentation. stub: canned text built from the assembled context, zero LLM calls.
# Unlike GOVERNANCE_MODE (default stub), this defaults to live: the assistant makes no
# request a person didn't just type, so there's no accidental-call risk to protect
# against by defaulting safe. See backend/app/services/assistant_llm.py.
ASSISTANT_MODE=live

# Which provider answers the assistant. Falls back to GOVERNANCE_PROVIDER, then gemini,
# exactly like a governance panel agent's own per-agent override — not pinned to any
# one provider.
#   GOVERNANCE_PROVIDER_ASSISTANT=claude

# --- logging -------------------------------------------------------------------------
# Standard Python logging level for the backend and governance lane.
# One of: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- frontend ------------------------------------------------------------------------
# Base URL the frontend's generated API client points at. Matches the backend
# dev server's port (see `make dev`).
API_BASE_URL=http://localhost:8000
